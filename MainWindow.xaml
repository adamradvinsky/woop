<Window x:Class="woop_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woop"
        Height="750"
        Width="900"
        Background="Black">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- BUTTONS + STATUS                                      -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button x:Name="ConnectButton"
                    Content="Connect to WHOOP"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="ConnectButton_Click"/>

            <Button x:Name="SendHelloButton"
                    Content="Send Hello"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SendHelloButton_Click"/>

            <Button x:Name="RefreshWoopButton"
                    Content="Refresh Info"
                    Width="110"
                    Height="35"
                    Click="RefreshWoopButton_Click"/>

            <TextBlock x:Name="StatusText"
                       Text="Disconnected"
                       Foreground="Red"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontSize="14"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- WHOOP COMMANDS                                        -->
        <!-- Auto-generated: one button per WhoopCommands enum     -->
        <!-- value (see PopulateCommandButtons in the code-behind) -->
        <!-- Add a new value to the enum in StrapClient.cs and a   -->
        <!-- matching button appears here automatically, no XAML   -->
        <!-- changes needed.                                       -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                BorderBrush="#444444"
                BorderThickness="1"
                Margin="0,0,0,10"
                Background="#111111">

            <StackPanel Margin="10">

                <TextBlock Text="WHOOP COMMANDS"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="90">

                    <WrapPanel x:Name="CommandsPanel"
                               Orientation="Horizontal"/>

                </ScrollViewer>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- PAIRABLE DEVICES                                      -->
        <!-- ===================================================== -->

        <ListBox x:Name="Pairable_Devices"
                 Grid.Row="2"
                 Background="#222222"
                 Foreground="White"
                 DisplayMemberPath="Name"
                 SelectionChanged="Pairable_Devices_SelectionChanged">
        </ListBox>


        <!-- ===================================================== -->
        <!-- WOOP DEBUG INFORMATION                                -->
        <!-- ===================================================== -->

        <Border Grid.Row="3"
                BorderBrush="#444444"
                BorderThickness="1"
                Margin="0,10,0,0"
                Background="#111111">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Header -->

                <TextBlock Grid.Row="0"
                           Text="WHOOP INSTANCE"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="10,10,10,5"/>


                <!-- Information -->

                <TextBox x:Name="WoopInfoText"
                         Grid.Row="1"
                         Text="Woop information will appear here..."
                         FontFamily="Consolas"
                         FontSize="13"
                         Foreground="White"
                         Background="#111111"
                         BorderThickness="0"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Margin="10,5,10,10"/>

            </Grid>

        </Border>

    </Grid>

</Window>
