<Window x:Class="woop_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woop" Height="750" Width="900"
        Background="Black">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connect button + status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ConnectButton" Content="Connect to WHOOP" Width="160" Height="35" Click="ConnectButton_Click"/>
            <TextBlock x:Name="StatusText" Text="Disconnected" Foreground="Red" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="14"/>
        </StackPanel>


        <ListBox x:Name="Pairable_Devices" 
         Grid.Row="5" 
         Background="#222222" 
         Foreground="White" 
         DisplayMemberPath="Name"
         SelectionChanged="Pairable_Devices_SelectionChanged">
        </ListBox>



