                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="AVERAGE HEART RATE" Foreground="Gray" FontSize="14" Margin="5"/>
                <Canvas x:Name="GraphCanvas" Grid.Row="1" Background="#111111" Margin="5" SizeChanged="GraphCanvas_SizeChanged"/>
            </Grid>
