<Window x:Class="woop_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Woop"
        Height="750"
        Width="900"
        Background="Black">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Buttons + status -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button x:Name="ConnectButton"
                    Content="Connect to WHOOP"
                    Width="160"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="ConnectButton_Click"/>

            <Button x:Name="SendHelloButton"
                    Content="Send Hello"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="SendHelloButton_Click"/>

            <Button x:Name="SendCommandButton"
                    Content="Send Command"
                    Width="120"
                    Height="35"
                    Click="SendCommandButton_Click"/>

            <TextBlock x:Name="StatusText"
                       Text="Disconnected"
                       Foreground="Red"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"
                       FontSize="14"/>

        </StackPanel>


        <!-- Pairable devices -->
        <ListBox x:Name="Pairable_Devices"
                 Grid.Row="1"
                 Background="#222222"
                 Foreground="White"
                 DisplayMemberPath="Name"
                 SelectionChanged="Pairable_Devices_SelectionChanged">
        </ListBox>


        <!-- Graph -->
        <!--
        <Border Grid.Row="3"
                BorderBrush="White"
                BorderThickness="2"
                Margin="5">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="AVERAGE HEART RATE"
                           Foreground="Gray"
                           FontSize="14"
                           Margin="5"/>

                <Canvas x:Name="GraphCanvas"
                        Grid.Row="1"
                        Background="#111111"
                        Margin="5"
                        SizeChanged="GraphCanvas_SizeChanged"/>

            </Grid>
        </Border>
        -->

    </Grid>
</Window>